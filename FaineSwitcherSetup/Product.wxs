<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
    <Package Name="FaineSwitcher" Language="1033" Version="2.0.0.0" Manufacturer="FaineSwitcher" UpgradeCode="62cead8a-23fd-4389-98e4-04fb7f61f62d">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- UI settings -->
    <UI>
      <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
      <ui:WixUI Id="WixUI_InstallDir" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch FaineSwitcher" />

    <!-- include the start app action -->
    <Property Id="WixShellExecTarget" Value="[#FaineSwitcher.exe]" />
    <CustomAction Id="LaunchApplication" DllEntry="WixShellExec" Impersonate="yes" BinaryRef="Wix4UtilCA_X86" />

    <Feature Id="FaineSwitcherFeature" Title="FaineSwitcher" Level="1">
      <ComponentGroupRef Id="AppComponent" />
      <!-- <ComponentGroupRef Id="FaineSwitcherShortcuts" /> -->
    </Feature>
  </Package>
</Wix>
