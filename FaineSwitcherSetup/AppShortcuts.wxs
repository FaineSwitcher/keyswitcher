<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Fragment>

      <DirectoryRef Id="ApplicationProgramsFolder">
        <Component Id="ApplicationShortcut" Guid="cde1e030-eb64-49a5-b7b8-400b379c2d1a">
          <Shortcut Id="ApplicationStartMenuShortcut" Name="!(bind.Property.Name)" Description="FaineSwitcher" Target="[#FaineSwitcher.exe]" WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\!(bind.Property.Manufacturer)" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </DirectoryRef>

      <StandardDirectory Id="DesktopFolder">
        <Component Id="ApplicationShortcutDesktop" Guid="73982b5d-04c1-4f76-8a7a-a71db62c34cf">
          <Shortcut Id="ApplicationShortcutDesktopShortcut" Name="!(bind.Property.Name)" Description="FaineSwitcher" Target="[#FaineSwitcher.exe]" WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="DesktopFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\!(bind.Property.Manufacturer)" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </StandardDirectory>

    <ComponentGroup Id="FaineSwitcherShortcuts">
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="ApplicationShortcutDesktop" />
    </ComponentGroup>
    
  </Fragment>
</Wix>
