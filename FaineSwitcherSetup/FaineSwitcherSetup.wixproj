<Project Sdk="WixToolset.Sdk/5.0.1">
  <PropertyGroup>
    <DefineConstants>Version=$(BuildVersion)</DefineConstants>
    <SuppressIces>ICE60</SuppressIces>
    <RuntimeIdentifiers>win-x64;win-x32</RuntimeIdentifiers>
    <Platforms>x64</Platforms>
    <Configurations>Release</Configurations>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.1" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.1" />
  </ItemGroup>
  <ItemGroup>
    <BindPath BindName="AppArtifacts" Include="$(artifacts)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FaineSwitcher\FaineSwitcher.csproj" />
  </ItemGroup>
</Project>