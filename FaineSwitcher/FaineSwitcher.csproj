<Project Sdk="Microsoft.NET.Sdk">
  <!-- Common Properties -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <RootNamespace>FaineSwitch</RootNamespace>
    <AssemblyName>FaineSwitch</AssemblyName>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
  </PropertyGroup>

  <!-- Assembly Info  -->
  <PropertyGroup>
    <AssemblyTitle>FaineSwitcher</AssemblyTitle>
    <AssemblyDescription>A magic layout switcher.</AssemblyDescription>
    <AssemblyConfiguration></AssemblyConfiguration>
    <AssemblyCompany>SaaSJet &amp; FaineTech</AssemblyCompany>
    <AssemblyProduct>FaineSwitcher</AssemblyProduct>
    <AssemblyCopyright>Copyright © SaaSJet &amp; FaineTech 2023</AssemblyCopyright>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <NeutralResourcesLanguage></NeutralResourcesLanguage>
    <AssemblyDefaultAlias>SaaSJet &amp; FaineTech</AssemblyDefaultAlias>
  </PropertyGroup>

  <!-- Configuration/Platform Specific Properties -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x86'">
    <OutputPath>bin\Release_x86\</OutputPath>
    <SignManifests>True</SignManifests>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x86'">
    <OutputPath>bin\Debug_x86\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <OutputPath>bin\Release_x86_x64\</OutputPath>
    <SignManifests>True</SignManifests>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <OutputPath>bin\Debug_x86_x64\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\Release_x64\</OutputPath>
    <SignManifests>True</SignManifests>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <OutputPath>bin\Debug_x64\</OutputPath>
  </PropertyGroup>

  <!-- References and Items -->
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Update="System">
      <RequiredTargetFramework>4.0</RequiredTargetFramework>
    </Reference>
    <Reference Update="System.Drawing">
      <RequiredTargetFramework>4.0</RequiredTargetFramework>
    </Reference>
    <Reference Include="System.Net">
      <RequiredTargetFramework>4.0</RequiredTargetFramework>
    </Reference>
    <Reference Include="System.Web" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="JustUI\JUIButton.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="JustUI\JUITitle.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="ML\MLModel1.consumption.cs">
      <DependentUpon>MLModel1.mbconfig</DependentUpon>
    </Compile>
    <Compile Update="ML\MLModel1.training.cs">
      <DependentUpon>MLModel1.mbconfig</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="ML\MLModel1.zip">
      <DependentUpon>MLModel1.mbconfig</DependentUpon>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Content Include="AS_dict.txt" />
    <None Update="FaineSwitch.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PublishFile Include="AS_dict.txt">
      <Visible>False</Visible>
      <Group></Group>
      <TargetPath></TargetPath>
      <PublishState>DataFile</PublishState>
      <IncludeHash>True</IncludeHash>
      <FileType>File</FileType>
    </PublishFile>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML" Version="2.0.1" />
    <PackageReference Include="Microsoft.ML.CpuMath" Version="2.0.1" />
    <PackageReference Include="Microsoft.ML.DataView" Version="2.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="System.Buffers" Version="4.4.0" />
    <PackageReference Include="System.CodeDom" Version="4.5.0" />
    <PackageReference Include="System.Collections.Immutable" Version="1.5.0" />
    <PackageReference Include="System.Memory" Version="4.5.3" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.4.0" />
    <PackageReference Include="System.Reflection.Emit.Lightweight" Version="4.3.0" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="4.5.3" />
    <PackageReference Include="System.Threading.Channels" Version="4.7.1" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
  </ItemGroup>
</Project>
